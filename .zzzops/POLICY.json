  "charter": {
    "acceptance_criteria": [
      "Substantial repository-changing work uses Managed ZzzOps workflow except explicit scoped exemptions.",
      "Each coherent source/resource surface has one writer at a time and parallel lanes are non-overlapping.",
      "Exact candidate head and current target are re-fetched before promotion; stale reviews do not authorize moved heads.",
      "GitHub Actions/runners are not Jarvis execution, validation, deployment, recovery, HostOps, or reviewer-quorum authority.",
      "Completed goals require observable verification evidence appropriate to the changed artifact."
    ],
    "beneficiaries": [
      "Jarvis Host Ops operators",
      "Pixel Network control-plane maintainers"
    ],
    "constraints": [
      "No Jarvis source code, credentials, tokens, secrets, environment files, private configuration, or private receipts.",
      "No GitHub Actions/runners and no execution of code from this repository on Windows hosts.",
      "Only bounded JSON command envelopes may use the protected control-branch contract.",
      "Preserve one-writer ownership, exact-head validation, local/approved validation, receipts/auditability, and fail-closed handling."
    ],
    "kpis": [
      {
        "baseline": "Quantitative historical rate not yet measured.",
        "cadence": "Per promotion.",
        "evidence": "PR metadata, local verification receipts, exact-head comparison records.",
        "name": "Exact-head change integrity",
        "target": "100% of promoted source changes bind review/verification to the exact candidate head and current target state.",
        "why": "Stale evidence must not authorize moved source."
      },
      {
        "baseline": "Quantitative historical coverage not yet measured.",
        "cadence": "Per goal completion.",
        "evidence": "ZzzOps goal records, local test/runtime outputs, review receipts.",
        "name": "Verified completion integrity",
        "target": "100% of completed substantial goals carry artifact-appropriate observable evidence.",
        "why": "Process start or agent prose is not completion proof."
      }
    ],
    "non_goals": [
      "Hosting private Jarvis source or receipts.",
      "Executing commands or scripts from repository content."
    ],
    "outcome": "Maintain a public, non-executable transport for bounded Jarvis Host Ops command envelopes while preserving strict separation from private source, credentials, receipts, and execution authority.",
    "precedence": "Safety and authorization first; correctness and evidence integrity second; repository outcome and throughput third; convenience and cost last.",
    "time_horizon": "Ongoing repository operation; review whenever canonical ownership, execution authority, security boundaries, or release governance materially changes.",
    "unacceptable_tradeoffs": [
      "Any convenience path that turns transport content into executable authority.",
      "Weakening protected branch/genesis or envelope validation."
    ],
    "why_it_matters": "The transport must carry bounded command envelopes without becoming a source or code-execution channel."
  },
